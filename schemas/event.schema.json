{
    "type": "object",
    "required": [
        "id",
        "title",
        "description",
        "city",
        "venue",
        "starts_at",
        "capacity",
        "status"
    ],
    "additionalProperties": false,
    "properties": {
        "id": {
            "type": "integer",
            "minimum": 0
        },
        "title": {
            "type": "string",
            "minLength": 3
        },
        "description": {
            "type": "string"
        },
        "city": {
            "type": "string"
        },
        "venue": {
            "type": "string",
            "minLength": 3
        },
        "starts_at": {
            "type": "string",
            "pattern": "^(\\d{4})-([0-1]\\d)-([0-3]\\d)"
        },
        "capacity": {
            "type": "integer",
            "minimum": 1
        },
        "status": {
            "type": "string",
            "enum": [
                "published",
                "cancelled",
                "draft"
            ]
        },
        "cover_color": {
            "type": "string",
            "pattern": "^#([\\dA-F]{6})$"
        }
    }
}